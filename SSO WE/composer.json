{
    "name": "sso/webtool",
    "description": "SSO Webtool - A secure Single Sign-On solution",
    "type": "project",
    "require": {
        "php": "^7.4|^8.0",
        "vlucas/phpdotenv": "^5.4",
        "sendgrid/sendgrid": "^7.11",
        "twilio/sdk": "^6.40",
        "ramsey/uuid": "^4.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "App/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
